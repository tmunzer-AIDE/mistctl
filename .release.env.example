# Copy to .release.env (git-ignored) and fill in. Read by scripts/release.sh;
# variables already set in your environment take precedence.

# Name (or SHA-1 hash) of the Developer ID Application identity in your
# keychain, as listed by: security find-identity -v -p codesigning
CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# notarytool keychain profile, created once with:
#   xcrun notarytool store-credentials mistctl-notary --apple-id you@example.com --team-id TEAMID
NOTARY_PROFILE="mistctl-notary"
